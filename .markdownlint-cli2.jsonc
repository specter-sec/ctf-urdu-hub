{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD046": { "style": "fenced" },
    "MD025": false,
    "MD034": false,
    "MD036": false
  },
  "globs": [
    "*.md",
    "docs/**/*.md",
    ".github/**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "site/**"
  ]
}
